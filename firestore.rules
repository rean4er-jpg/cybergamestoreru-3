rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrapAdmin() {
      return isVerified() && request.auth.token.email == 'rean4er@gmail.com';
    }

    function isAdmin() {
      return isBootstrapAdmin() ||
        (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Validation Blueprint: Product (exact schema from firebase-blueprint.json)
    function isValidProduct(data) {
      return data.keys().hasAll([
          'id', 'sku', 'title', 'platformGroup', 'platformLabel',
          'categoryType', 'deliveryType', 'regionLabel', 'genre', 'brand',
          'editionLabel', 'language', 'hasRussian', 'isPreorder', 'inStock',
          'isHidden', 'priceRub', 'oldPriceRub', 'image', 'shortDescription',
          'fullDescription', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'sku', 'title', 'platformGroup', 'platformLabel',
          'categoryType', 'deliveryType', 'regionLabel', 'genre', 'brand',
          'editionLabel', 'language', 'hasRussian', 'isPreorder', 'inStock',
          'isHidden', 'priceRub', 'oldPriceRub', 'image', 'shortDescription',
          'fullDescription', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id.size() >= 2 && data.id.size() <= 80 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.sku is string && data.sku.size() >= 1 && data.sku.size() <= 40
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
        && data.platformGroup in ['ps', 'xbox']
        && data.platformLabel is string && data.platformLabel.size() >= 2 && data.platformLabel.size() <= 60
        && data.categoryType in ['games', 'subscriptions']
        && data.deliveryType in ['account', 'key', 'subscription']
        && data.regionLabel is string && data.regionLabel.size() >= 2 && data.regionLabel.size() <= 50
        && data.genre is string && data.genre.size() >= 2 && data.genre.size() <= 80
        && data.brand is string && data.brand.size() >= 1 && data.brand.size() <= 80
        && data.editionLabel is string && data.editionLabel.size() >= 1 && data.editionLabel.size() <= 80
        && data.language is string && data.language.size() >= 2 && data.language.size() <= 100
        && data.hasRussian is bool
        && data.isPreorder is bool
        && data.inStock is bool
        && data.isHidden is bool
        && data.priceRub is number && data.priceRub >= 1 && data.priceRub <= 500000
        && data.oldPriceRub is number && data.oldPriceRub >= 0 && data.oldPriceRub <= 500000
        && data.image is string && data.image.size() <= 450000
        && data.shortDescription is string && data.shortDescription.size() <= 300
        && data.fullDescription is string && data.fullDescription.size() <= 4000
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: Sale (exact schema from firebase-blueprint.json)
    function isValidSale(data) {
      return data.keys().hasAll([
          'id', 'orderDate', 'productId', 'productTitle', 'platformGroup',
          'categoryType', 'quantity', 'unitPriceRub', 'totalRub', 'status',
          'channel', 'paymentMethod', 'customerName', 'customerContact',
          'note', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'orderDate', 'productId', 'productTitle', 'platformGroup',
          'categoryType', 'quantity', 'unitPriceRub', 'totalRub', 'status',
          'channel', 'paymentMethod', 'customerName', 'customerContact',
          'note', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id.size() >= 2 && data.id.size() <= 80 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.orderDate is string && data.orderDate.size() == 10 && data.orderDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 80
        && data.productTitle is string && data.productTitle.size() >= 2 && data.productTitle.size() <= 160
        && data.platformGroup in ['ps', 'xbox']
        && data.categoryType in ['games', 'subscriptions']
        && data.quantity is int && data.quantity >= 1 && data.quantity <= 100
        && data.unitPriceRub is number && data.unitPriceRub >= 1 && data.unitPriceRub <= 500000
        && data.totalRub is number && data.totalRub >= 1 && data.totalRub <= 5000000
        && data.status in ['paid', 'pending', 'refunded', 'cancelled']
        && data.channel in ['site', 'telegram', 'avito', 'wildberries']
        && data.paymentMethod in ['sbp', 'card', 'transfer']
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120
        && data.customerContact is string && data.customerContact.size() <= 160
        && data.note is string && data.note.size() <= 400
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: AdminUser
    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.role == 'admin'
        && data.createdAt is timestamp;
    }

    // Storefront Catalog Products (publicly readable, zero PII, strictly admin-writable)
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if resource.data.priceRub >= 1 || isBootstrapAdmin();

      allow create: if isVerified()
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().id == productId
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();

      allow update: if isVerified()
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().id == productId
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (incoming().diff(existing()).affectedKeys().hasOnly([
            'sku', 'title', 'platformGroup', 'platformLabel', 'categoryType',
            'deliveryType', 'regionLabel', 'genre', 'brand', 'editionLabel',
            'language', 'hasRussian', 'isPreorder', 'inStock', 'isHidden',
            'priceRub', 'oldPriceRub', 'image', 'shortDescription',
            'fullDescription', 'updatedAt'
          ]) && isAdmin())
        );

      allow delete: if isVerified()
        && isValidId(productId)
        && isAdmin();
    }

    // Private Sales & Revenue Ledger (strict PII isolation, strictly admin-only)
    match /sales/{saleId} {
      allow get: if isVerified() && isValidId(saleId) && isAdmin();
      allow list: if isBootstrapAdmin()
        || (isVerified() && resource.data.createdBy == request.auth.uid);

      allow create: if isVerified()
        && isValidId(saleId)
        && isValidSale(incoming())
        && incoming().id == saleId
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();

      allow update: if isVerified()
        && isValidId(saleId)
        && isValidSale(incoming())
        && incoming().id == saleId
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'orderDate', 'productId', 'productTitle', 'platformGroup',
            'categoryType', 'quantity', 'unitPriceRub', 'totalRub',
            'status', 'channel', 'paymentMethod', 'customerName',
            'customerContact', 'note', 'updatedAt'
          ])) ||
          (existing().status != 'refunded'
            && existing().status != 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'note', 'updatedAt'])
            && isAdmin())
        );

      allow delete: if isVerified()
        && isValidId(saleId)
        && isAdmin();
    }

    // Admin Role Registry
    match /admins/{adminUid} {
      allow get: if isVerified() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if isBootstrapAdmin();

      allow create: if isVerified()
        && isValidId(adminUid)
        && isValidAdminUser(incoming())
        && incoming().uid == adminUid
        && incoming().createdAt == request.time
        && isAdmin();

      allow update: if isVerified()
        && isValidId(adminUid)
        && isValidAdminUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'role'])
        && isAdmin();

      allow delete: if isVerified()
        && isValidId(adminUid)
        && isAdmin();
    }
  }
}
